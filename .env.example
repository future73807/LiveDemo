# 复制为 .env 并修改；.env 已被 .gitignore 排除，不会提交

# WebRTC 候选地址：公网部署必须填服务器公网 IP（本地保持 127.0.0.1）
# 本机联调时若浏览器拉不到流（多虚拟网卡/候选地址不通），改为本机局域网 IP（如 192.168.31.222）
SRS_CANDIDATE=127.0.0.1

# 可选：SRS 端口被占用/被保留时的重映射（后端按 relaxed binding 读取）
# LIVE_SRS_API_PORT=21985
# LIVE_SRS_HTTP_PORT=18080

# JWT 签发密钥：至少 32 字节随机串的 Base64（生成：openssl rand -base64 32）
LIVE_JWT_SECRET=

# 管理员引导账号（internal 模式，启动时创建）
LIVE_ADMIN_USER=admin
LIVE_ADMIN_PASSWORD=

# 播放地址模式：host=本地开发（按 localhost:端口 拼地址）；base=公网 HTTPS（按域名拼同源地址）
LIVE_PLAY_URL_MODE=host
LIVE_PUBLIC_BASE_URL=

# 可选：绑定地址（默认全网卡；如仅本机调试可改 127.0.0.1）
# WEB_BIND=0.0.0.0
# SRS_UDP_BIND=0.0.0.0
